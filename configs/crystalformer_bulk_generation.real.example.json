{
  "crystalformer_work_dir": "external/CrystalFormer",
  "checkpoint_dir": "external/checkpoints/crystalformer",
  "output_root": "outputs/crystalformer_bulk_real_smoke",
  "parser_backend": "none",
  "stability_mode": "unavailable_without_offline_validation",
  "source_format": "auto",
  "skip_existing": true,
  "defaults": {
    "num_samples": 5,
    "top_k": 40
  },
  "command_template": "python ./main.py --optimizer none --restore_path {checkpoint_dir} --K {top_k} --num_samples {num_samples} --formula {formula} --save_path {raw_output_dir}",
  "formulas": [
    {
      "formula": "BaTiO3",
      "num_samples": 5
    }
  ]
}
