+def GLXYZAW_from_raw_sequence_jsonl(jsonl_file, n_max):
+    """
+    Read FIIR raw-sequence JSONL rows containing g, L, X, A, W fields.
+
+    This bypasses CIF parsing and keeps FIIR DPO smoke data aligned with the
+    native CrystalFormer token arrays emitted by generation.
+    """
+    rows = []
+    with open(jsonl_file, "r", encoding="utf-8") as handle:
+        for line in handle:
+            stripped = line.strip()
+            if stripped:
+                rows.append(json.loads(stripped))
+    G, L, XYZ, A, W = [], [], [], [], []
+    for row in rows:
+        sequence = row.get("sequence", row)
+        G.append(int(_parse_raw_sequence_value(sequence["g"])))
+        L.append([float(value) for value in _parse_raw_sequence_value(sequence["L"])])
+        XYZ.append(_parse_xyz_sequence(sequence.get("X", sequence.get("XYZ"))))
+        A.append([int(value) for value in _parse_raw_sequence_value(sequence["A"])])
+        W.append([int(value) for value in _parse_raw_sequence_value(sequence["W"])])
+
+    G = jnp.array(G)
+    A = jnp.array(A).reshape(-1, n_max)
+    W = jnp.array(W).reshape(-1, n_max)
+    XYZ = jnp.array(XYZ).reshape(-1, n_max, 3)
+    L = jnp.array(L).reshape(-1, 6)
+
+    A, XYZ = sort_atoms(W, A, XYZ)
+
+    return G, L, XYZ, A, W
+
+def _parse_raw_sequence_value(value):
+    if isinstance(value, str):
+        value = value.strip()
+        try:
+            return json.loads(value)
+        except json.JSONDecodeError:
+            try:
+                return ast.literal_eval(value)
+            except (SyntaxError, ValueError):
+                return value
+    return value
+
+def _parse_xyz_sequence(value):
+    parsed = _parse_raw_sequence_value(value)
+    return [[float(item) for item in row] for row in parsed]
+
